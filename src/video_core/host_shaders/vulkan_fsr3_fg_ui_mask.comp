// Frame generation and the game's UI. Fortune's Weave draws its UI into a layer of its own and then
// combines it with the 3D picture: in linear light, frame = ui.rgb + ui.a * scene (ui.a is the
// scene's share, 1 where there is no UI). That makes the UI removable:
//  - mode 0 (before interpolation) takes the UI out of the real frame, so frame generation moves
//    only the scene, even behind see-through panels: scene = (frame - ui.rgb) / ui.a;
//  - mode 1 (after it) puts this frame's UI back over the generated scene, unmoved.
// Where the UI is solid (or near its edges) the scene isn't recovered: see SOLID below.
// Layers past the first are only masked (the generated frame takes the real frame's pixels).
// HDR frames (the game's own PQ or scRGB picture, whose combine isn't known): mode 3 (before
// interpolation) fills every UI-covered pixel from the scene around it, so frame generation never
// moves the UI there either, and mode 2 (after it) gives those pixels back the real frame's.

#version 460
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

// Up to four UI layers (the game may draw its UI into more than one); unused ones repeat the first.
layout(set = 0, binding = 0) uniform texture2D ui_layer0;
layout(set = 0, binding = 1) uniform texture2D ui_layer1;
layout(set = 0, binding = 2) uniform texture2D ui_layer2;
layout(set = 0, binding = 3) uniform texture2D ui_layer3;
layout(set = 0, binding = 4) uniform texture2D current_frame;
// Mode 0: the UI-less frame. Mode 1: the generated frame, finished in place.
layout(set = 0, binding = 5) uniform image2D target;
layout(set = 0, binding = 6, std140) uniform Constants {
    ivec2 rect_base;
    ivec2 rect_size;
    float threshold;
    uint show_mask;
    uint layer_count;
    uint mode;
} c;
// Mode 0: the UI's coverage (0 where none; widened), for NVIDIA's frame generation.
layout(set = 0, binding = 7) uniform image2D ui_alpha;
layout(set = 0, binding = 1000) uniform sampler linear_sampler;

// Where the UI (widened by a couple of texels) covers more than this, the scene isn't taken from
// the frame (its UI edges never subtract cleanly: the UI is scaled twice on its way to the screen,
// and what is left would be moved with the scene as a ghost of the UI): frame generation gets a
// fill from the scene around it instead, and the real frame's pixels are kept there.
const float SOLID = 0.45;
const float SOLID_EDGE = 0.3;

vec3 ToLinear(vec3 v) {
    v = clamp(v, 0.0, 1.0);
    return mix(v / 12.92, pow((v + 0.055) / 1.055, vec3(2.4)), greaterThan(v, vec3(0.04045)));
}

vec3 ToSrgb(vec3 v) {
    v = clamp(v, 0.0, 1.0);
    return mix(v * 12.92, 1.055 * pow(v, vec3(1.0 / 2.4)) - 0.055, greaterThan(v, vec3(0.0031308)));
}

float coverage(texture2D layer, vec2 uv) {
    const vec2 step = 1.5 / vec2(textureSize(sampler2D(layer, linear_sampler), 0));
    float result = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            result = max(result, 1.0 - textureLod(sampler2D(layer, linear_sampler),
                                                  uv + vec2(x, y) * step, 0.0).a);
        }
    }
    return result;
}

// Every layer's coverage around uv, widened.
float AllCoverage(vec2 uv) {
    float result = coverage(ui_layer0, uv);
    if (c.layer_count > 1) {
        result = max(result, coverage(ui_layer1, uv));
    }
    if (c.layer_count > 2) {
        result = max(result, coverage(ui_layer2, uv));
    }
    if (c.layer_count > 3) {
        result = max(result, coverage(ui_layer3, uv));
    }
    return result;
}

// Coverage at one point (first layer and the others), unwidened.
float PointCoverage(vec2 uv) {
    float result = 1.0 - textureLod(sampler2D(ui_layer0, linear_sampler), uv, 0.0).a;
    if (c.layer_count > 1) {
        result = max(result, 1.0 - textureLod(sampler2D(ui_layer1, linear_sampler), uv, 0.0).a);
    }
    return result;
}

// The scene around a UI-covered pixel: in eight directions, the nearest frame pixel without UI,
// averaged (nearer weighs more). Smooth and UI-free, so moving it shows no UI. HDR frames (mode 3)
// are averaged as they are encoded.
vec3 Fill(ivec2 local, vec3 fallback) {
    const vec2 directions[8] = vec2[8](vec2(1, 0), vec2(-1, 0), vec2(0, 1), vec2(0, -1),
                                       vec2(0.7071, 0.7071), vec2(-0.7071, 0.7071),
                                       vec2(0.7071, -0.7071), vec2(-0.7071, -0.7071));
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (int d = 0; d < 8; ++d) {
        float distance = 4.0;
        for (int i = 0; i < 7; ++i, distance *= 2.0) {
            const ivec2 p = local + ivec2(directions[d] * distance);
            if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, c.rect_size))) {
                break;
            }
            const vec2 uv = (vec2(p) + 0.5) / vec2(c.rect_size);
            if (PointCoverage(uv) < c.threshold) {
                const float w = 1.0 / distance;
                const vec3 texel = texelFetch(current_frame, p + c.rect_base, 0).rgb;
                sum += w * (c.mode == 3 ? texel : ToLinear(texel));
                weight += w;
                break;
            }
        }
    }
    return weight > 0.0 ? sum / weight : fallback;
}

void main() {
    const ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pos, imageSize(target)))) {
        return;
    }
    const vec4 current = texelFetch(current_frame, pos, 0);
    const ivec2 local = pos - c.rect_base;
    if (any(lessThan(local, ivec2(0))) || any(greaterThanEqual(local, c.rect_size))) {
        if (c.mode == 0 || c.mode == 3) {
            imageStore(target, pos, current);
            imageStore(ui_alpha, pos, vec4(0.0));
        }
        return;
    }
    const vec2 uv = (vec2(local) + 0.5) / vec2(c.rect_size);
    const float widened = AllCoverage(uv);
    if (c.mode == 3) {
        imageStore(ui_alpha, pos, vec4(widened < c.threshold ? 0.0 : clamp(widened, 0.0, 1.0)));
        if (widened < c.threshold) {
            imageStore(target, pos, current);
        } else {
            imageStore(target, pos, vec4(Fill(local, current.rgb), current.a));
        }
        return;
    }
    if (c.mode == 2) {
        const float mask = smoothstep(c.threshold, c.threshold * 8.0, widened);
        if (c.show_mask != 0) {
            imageStore(target, pos, vec4(vec3(mask), 1.0));
        } else if (mask > 0.0) {
            const vec4 generated = imageLoad(target, pos);
            imageStore(target, pos, vec4(mix(generated.rgb, current.rgb, mask), generated.a));
        }
        return;
    }
    // 0 where the UI is see-through (taken out and put back), 1 where it is solid (kept).
    const float solid = smoothstep(SOLID_EDGE, SOLID, widened);
    const vec3 current_linear = ToLinear(current.rgb);
    const vec4 ui = textureLod(sampler2D(ui_layer0, linear_sampler), uv, 0.0);
    const float share = clamp(ui.a, 1.0 - SOLID, 1.0);

    if (c.mode == 0) {
        imageStore(ui_alpha, pos, vec4(widened < c.threshold ? 0.0 : clamp(widened, 0.0, 1.0)));
        if (widened < c.threshold) {
            imageStore(target, pos, current);
            return;
        }
        vec3 scene = (current_linear - ui.rgb) / share;
        if (solid > 0.0) {
            scene = mix(scene, Fill(local, scene), solid);
        }
        imageStore(target, pos, vec4(ToSrgb(scene), current.a));
        return;
    }

    if (c.show_mask != 0) {
        // Red: see-through UI, put back over the generated scene; green: solid UI, kept from the
        // real frame.
        const float seen = smoothstep(c.threshold, c.threshold * 8.0, widened);
        imageStore(target, pos, vec4(seen * (1.0 - solid), solid, 0.0, 1.0));
        return;
    }
    if (widened < c.threshold) {
        return; // No UI: the generated scene as it is.
    }
    const vec4 generated = imageLoad(target, pos);
    const vec3 with_ui = ui.rgb + share * ToLinear(generated.rgb);
    imageStore(target, pos, vec4(ToSrgb(mix(with_ui, current_linear, solid)), generated.a));
}
