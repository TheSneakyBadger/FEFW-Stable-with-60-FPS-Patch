// Compresses one level of an RGBA8 image (the ASTC decoder's output) to BC1 or BC3, one 4x4 block
// per invocation, so re-compressed ASTC never round-trips through the CPU. Colour endpoints start
// as the visible texels' bounding box, oriented along the colours' covariance and inset by 1/16,
// then get one least-squares refinement; each texel takes the nearest palette entry. Values are
// encoded as stored (sRGB data stays sRGB, like the CPU path).

#version 460 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (set = 0, binding = 0, rgba8) uniform readonly image2DArray source;

layout (std430, set = 0, binding = 1) writeonly buffer Output {
    uvec2 blocks[];
};

layout (push_constant) uniform PushConstants {
    uint blocks_x;
    uint blocks_y;
    uint width;
    uint height;
    uint bc3;
    uint out_offset; // in 8-byte units
};

uint Pack565(vec3 color) {
    const uvec3 q = uvec3(round(clamp(color, 0.0, 1.0) * vec3(31.0, 63.0, 31.0)));
    return (q.r << 11) | (q.g << 5) | q.b;
}

vec3 Unpack565(uint value) {
    const uvec3 q = uvec3((value >> 11) & 31u, (value >> 5) & 63u, value & 31u);
    const uvec3 e = uvec3((q.r << 3) | (q.r >> 2), (q.g << 2) | (q.g >> 4), (q.b << 3) | (q.b >> 2));
    return vec3(e) / 255.0;
}

float Distance2(vec3 a, vec3 b) {
    const vec3 d = a - b;
    return dot(d, d);
}

// Whether a texel's colour can't be seen, so it shouldn't widen the block's colour range. BC3:
// fully transparent texels (overlays such as faces' mouths often hold leftover colours there, and
// counting them spread the visible texels' colours into square patches at the edge). BC1 with
// punch_through: texels that take the transparent index.
bool Hidden(vec4 texel, bool punch_through, bool alpha_block) {
    return (punch_through && texel.a < 0.5) || (alpha_block && texel.a < 1.0 / 255.0);
}

// Four-colour mode for these endpoints (swapped so colour0 > colour1, as the mode needs):
// the block, and its squared error over the visible texels.
uvec2 FourColour(in vec4 texels[16], uint q0, uint q1, bool alpha_block, out float error) {
    if (q0 < q1) {
        const uint t = q0;
        q0 = q1;
        q1 = t;
    }
    error = 0.0;
    vec3 palette[4];
    palette[0] = Unpack565(q0);
    palette[1] = Unpack565(q1);
    palette[2] = (2.0 * palette[0] + palette[1]) / 3.0;
    palette[3] = (palette[0] + 2.0 * palette[1]) / 3.0;
    const int entries = q0 == q1 ? 1 : 4;
    uint indices = 0u;
    for (int i = 0; i < 16; ++i) {
        uint best = 0u;
        float best_distance = Distance2(texels[i].rgb, palette[0]);
        for (int p = 1; p < entries; ++p) {
            const float distance = Distance2(texels[i].rgb, palette[p]);
            if (distance < best_distance) {
                best_distance = distance;
                best = uint(p);
            }
        }
        if (!Hidden(texels[i], false, alpha_block)) {
            error += best_distance;
        }
        indices |= best << (2 * i);
    }
    return uvec2(q0 | (q1 << 16), indices);
}

// Three-colour mode with the transparent index for texels with alpha < 0.5 (BC1 only).
uvec2 EncodeThreeColour(in vec4 texels[16], uint q0, uint q1) {
    if (q0 > q1) {
        const uint t = q0;
        q0 = q1;
        q1 = t;
    }
    vec3 palette[3];
    palette[0] = Unpack565(q0);
    palette[1] = Unpack565(q1);
    palette[2] = (palette[0] + palette[1]) * 0.5;
    uint indices = 0u;
    for (int i = 0; i < 16; ++i) {
        uint best = 3u;
        if (texels[i].a >= 0.5) {
            best = 0u;
            float best_distance = Distance2(texels[i].rgb, palette[0]);
            for (int p = 1; p < 3; ++p) {
                const float distance = Distance2(texels[i].rgb, palette[p]);
                if (distance < best_distance) {
                    best_distance = distance;
                    best = uint(p);
                }
            }
        }
        indices |= best << (2 * i);
    }
    return uvec2(q0 | (q1 << 16), indices);
}

// BC1 colour block. With punch_through (BC1 only), texels with alpha < 0.5 use the transparent
// index of the three-colour mode; otherwise the four-colour mode is used (BC3 always decodes so).
// alpha_block: BC3's colour half, where the alpha half decides what is visible.
uvec2 EncodeColor(in vec4 texels[16], bool punch_through, bool alpha_block) {
    vec3 lo = vec3(1.0);
    vec3 hi = vec3(0.0);
    for (int i = 0; i < 16; ++i) {
        if (Hidden(texels[i], punch_through, alpha_block)) {
            continue;
        }
        lo = min(lo, texels[i].rgb);
        hi = max(hi, texels[i].rgb);
    }
    if (any(greaterThan(lo, hi))) {
        // Every texel transparent: colour0 == colour1 selects three-colour mode, index 3 (BC1);
        // in BC3 the colour of a fully transparent block doesn't matter.
        return uvec2(0u, punch_through ? 0xFFFFFFFFu : 0u);
    }
    const vec3 center = (lo + hi) * 0.5;
    const vec3 extent = hi - lo;
    const int major = extent.g >= extent.r && extent.g >= extent.b ? 1 : (extent.r >= extent.b ? 0 : 2);
    vec3 covariance = vec3(0.0);
    for (int i = 0; i < 16; ++i) {
        if (Hidden(texels[i], punch_through, alpha_block)) {
            continue;
        }
        const vec3 d = texels[i].rgb - center;
        covariance += d * d[major];
    }
    vec3 e0 = hi;
    vec3 e1 = lo;
    for (int c = 0; c < 3; ++c) {
        if (covariance[c] < 0.0) {
            e0[c] = lo[c];
            e1[c] = hi[c];
        }
    }
    const vec3 inset = (e0 - e1) / 16.0;
    e0 -= inset;
    e1 += inset;

    uint q0 = Pack565(e0);
    uint q1 = Pack565(e1);
    if (punch_through) {
        return EncodeThreeColour(texels, q0, q1);
    }
    // Four-colour mode: pick the indices, then refine the endpoints once by least squares for
    // those indices and keep whichever fits the visible texels better.
    float error;
    uvec2 block = FourColour(texels, q0, q1, alpha_block, error);
    float a2 = 0.0;
    float b2 = 0.0;
    float ab = 0.0;
    vec3 ax = vec3(0.0);
    vec3 bx = vec3(0.0);
    for (int i = 0; i < 16; ++i) {
        if (Hidden(texels[i], false, alpha_block)) {
            continue;
        }
        const uint index = (block.y >> (2 * i)) & 3u;
        // Palette order: 0 = colour0, 1 = colour1, 2 = 2/3 colour0, 3 = 1/3 colour0.
        const float w0 = index == 0u ? 1.0 : (index == 1u ? 0.0 : (index == 2u ? 2.0 / 3.0 : 1.0 / 3.0));
        const float w1 = 1.0 - w0;
        a2 += w0 * w0;
        b2 += w1 * w1;
        ab += w0 * w1;
        ax += w0 * texels[i].rgb;
        bx += w1 * texels[i].rgb;
    }
    const float det = a2 * b2 - ab * ab;
    if (abs(det) > 1e-6) {
        const vec3 r0 = clamp((ax * b2 - bx * ab) / det, 0.0, 1.0);
        const vec3 r1 = clamp((bx * a2 - ax * ab) / det, 0.0, 1.0);
        float refined_error;
        const uvec2 refined = FourColour(texels, Pack565(r0), Pack565(r1), alpha_block, refined_error);
        if (refined_error < error) {
            block = refined;
        }
    }
    return block;
}

// BC3 alpha block: eight-value mode (alpha0 > alpha1), indices 0 = alpha0, 1 = alpha1, 2..7 the
// ramp from alpha0 to alpha1.
uvec2 EncodeAlpha(in vec4 texels[16]) {
    float lo = 1.0;
    float hi = 0.0;
    for (int i = 0; i < 16; ++i) {
        lo = min(lo, texels[i].a);
        hi = max(hi, texels[i].a);
    }
    const uint a0 = uint(round(hi * 255.0));
    const uint a1 = uint(round(lo * 255.0));
    uint bits_lo = a0 | (a1 << 8);
    uint bits_hi = 0u;
    if (a0 == a1) {
        return uvec2(bits_lo, bits_hi);
    }
    for (uint i = 0u; i < 16u; ++i) {
        const float t = (texels[i].a * 255.0 - float(a1)) / float(a0 - a1);
        const uint q = uint(clamp(round(t * 7.0), 0.0, 7.0));
        const uint index = q == 7u ? 0u : (q == 0u ? 1u : 8u - q);
        const uint bit = 16u + 3u * i;
        if (bit < 32u) {
            bits_lo |= index << bit;
            if (bit > 29u) {
                bits_hi |= index >> (32u - bit);
            }
        } else {
            bits_hi |= index << (bit - 32u);
        }
    }
    return uvec2(bits_lo, bits_hi);
}

void main() {
    const uvec3 id = gl_GlobalInvocationID;
    if (id.x >= blocks_x || id.y >= blocks_y) {
        return;
    }
    vec4 texels[16];
    const ivec2 base = ivec2(id.xy) * 4;
    const ivec2 last = ivec2(width, height) - 1;
    bool any_transparent = false;
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            // Edge blocks repeat the last row/column so padding doesn't widen the endpoints.
            const ivec2 coord = min(base + ivec2(x, y), last);
            texels[y * 4 + x] = imageLoad(source, ivec3(coord, int(id.z)));
            any_transparent = any_transparent || texels[y * 4 + x].a < 0.5;
        }
    }
    const uint block = (id.z * blocks_y + id.y) * blocks_x + id.x;
    if (bc3 != 0u) {
        blocks[out_offset + block * 2u] = EncodeAlpha(texels);
        blocks[out_offset + block * 2u + 1u] = EncodeColor(texels, false, true);
    } else {
        blocks[out_offset + block] = EncodeColor(texels, any_transparent, false);
    }
}
